# Copy this file to .env and fill in the values.

# ── Required ────────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ── Optional ─────────────────────────────────────────────────────────────────
# Channel id where the persistent controller panel is auto-posted on startup.
# Leave as 0 (or omit) to skip auto-posting; use /controller instead.
CONTROLLER_CHANNEL_ID=0

# Discord role ID whose members are allowed to add, delete, and toggle songs.
# Set to 0 (or omit) to allow all users to manage the song library (unrestricted).
MUSIC_MANAGER_ROLE_ID=0

# Database id of the song that is secretly injected into the queue with a
# 1-in-10 probability.  Set to 0 (or omit) to disable the rigged feature.
RIGGED_SONG_ID=0

# ── Radio broadcast intermissions ────────────────────────────────────────────
# Minimum number of non-bot users in the voice channel required before a
# broadcast clip is eligible to play automatically.  Set to 0 to always allow.
BROADCAST_MIN_USERS=3

# Number of regular songs that must play between automatic broadcast insertions.
# e.g. 3 = one broadcast clip plays after every 3 songs (default).
BROADCAST_INTERVAL=3
