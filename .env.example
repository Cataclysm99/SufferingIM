# Copy this file to .env and fill in values.

# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# ── Optional core settings ──────────────────────────────────────────────────
CONTROLLER_CHANNEL_ID=0
MUSIC_MANAGER_ROLE_ID=0

# Rigged song pool (comma-separated song IDs). Example: 3,7,12
RIGGED_SONG_IDS=
RIGGED_CHANCE=10

# Intermission timing
AD_INTERVAL_MINUTES=30
DJ_EVENT_INTERVAL_MINUTES=60
DJ_CYCLE_HOURS=6

# Day-based branding (Sunday = HeavenFM, Monday+ = SufferingFM)
SUFFERING_BOT_NAME=SufferingFM
HEAVEN_BOT_NAME=HeavenFM

# Optional local paths for profile image/banner swaps
SUFFERING_AVATAR_PATH=
HEAVEN_AVATAR_PATH=
SUFFERING_BANNER_PATH=
HEAVEN_BANNER_PATH=

