# Copy this file to .env and fill in values.

# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# ── Optional core settings ──────────────────────────────────────────────────
CONTROLLER_CHANNEL_ID=0
MUSIC_MANAGER_ROLE_ID=0

# Rigged song pool (comma-separated song IDs). Example: 3,7,12
RIGGED_SONG_IDS=
RIGGED_CHANCE=10

# Intermission timing
AD_INTERVAL_MINUTES=30
DJ_EVENT_INTERVAL_MINUTES=60
DJ_CYCLE_HOURS=6

# Optional: explicit ffmpeg executable path or command name
# (if empty, bot tries PATH first, then bundled imageio-ffmpeg binary)
FFMPEG_EXECUTABLE=

# ── yt-dlp authentication (for private / age-restricted / region-locked videos) ──
# Option 1 (recommended for servers): OAuth2 via the yt-dlp-youtube-oauth2 plugin.
# Install:           pip install yt-dlp-youtube-oauth2
# Authenticate once: yt-dlp --username oauth2 --password "" <any-youtube-url>
# After the one-time device-code flow the refresh token persists; no further maintenance needed.
YTDLP_OAUTH2=false

# Option 2: path to a Netscape-format cookies file exported from your browser.
# Use /update_cookies in Discord to refresh this file without SSH access.
# See https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
YTDLP_COOKIES_FILE=

# Option 3: pull live cookies directly from an installed browser.
# Supported values: chrome, chromium, firefox, edge, opera, safari, brave, vivaldi
# Leave blank to disable. When set, this takes priority over YTDLP_COOKIES_FILE.
# See https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
YTDLP_COOKIES_FROM_BROWSER=

# Cookie usage mode:
# - fallback: try anonymous first, retry with cookies only for auth-gated failures
# - always: always use configured cookies
# - off: never use cookies
YTDLP_COOKIE_MODE=fallback

# Optional: startup auth probe URL. Set this to one known age-restricted YouTube URL
# to verify cookie-based access in the terminal during bot startup.
YTDLP_AUTH_TEST_URL=

# Persona branding names
COLLECTOR_BOT_NAME=CollectorIM
SUFFERING_BOT_NAME=SufferFML
HEAVEN_BOT_NAME=HeavenIN

# Optional local paths for profile image/banner swaps
COLLECTOR_AVATAR_PATH=
SUFFERING_AVATAR_PATH=
HEAVEN_AVATAR_PATH=
COLLECTOR_BANNER_PATH=
SUFFERING_BANNER_PATH=
HEAVEN_BANNER_PATH=
